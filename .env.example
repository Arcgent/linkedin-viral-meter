# Copy to .env and fill in. .env is ignored by git.

# Required: Jev and the Claude extras run through OpenRouter. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: who you are and who you write for. Only used by the Claude extras
# ("Explain in words" and "Rewrite with Claude") so the playbook and rewrites fit your voice.
# CREATOR_CONTEXT=Founder of a 20-person logistics software company. Posts in English. Audience: operations managers at European wholesalers.

# Optional: pin a Jev version instead of the latest (default ~typesafe/jev-latest)
# JEV_MODEL=~typesafe/jev-latest

# Optional: OpenRouter's decisions endpoint is still on /api/alpha and may move
# JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions

# Optional: parallel Jev calls during the pattern search (default 10)
# JEV_CONCURRENCY=10

# Optional: call TypeSafe directly instead of OpenRouter
# JEV_DIRECT=1
# TYPESAFE_API_KEY=

# Optional: models for the Claude extras (any OpenRouter model id; you can also switch them in the app)
# ANALYZE_MODEL=anthropic/claude-opus-5
# SCORE_MODEL=anthropic/claude-sonnet-5

# Optional: port for the local app (default 3140)
# PORT=3140
